{
  "description": "Ping-engine policy cases (plan B3): input state + intent -> outcome. Run by the server's GamePingPolicyTest (the pure decision) and GamePingEngineTest (the engine against a database), and by the Tool's tests/application/tracking/test_shared_policy_vectors.py against OutgoingPositionPolicy (cases with \"tool\": true, which only need its rules: caught, break, joker fake, coordinate split) until phase 4 removes it. 'real' audiences receive the real position, 'fake' ones the intent's fake coordinate; a used joker fake gives the hunters its coordinate instead of the real one.",
  "stateDefaults": {
    "active": true,
    "tracked": true,
    "caught": false,
    "onBreak": false,
    "otherPlayers": true,
    "otherSupporters": true,
    "mirrors": [
      "hunters",
      "players",
      "supporters"
    ],
    "position": "fresh",
    "pastNotAfter": false,
    "jokerFake": false
  },
  "relayStateDefaults": {
    "active": true,
    "caught": false,
    "onBreak": false,
    "pastNotAfter": false
  },
