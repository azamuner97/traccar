# Copy this file to docker/compose/.env.production and replace every placeholder.
# Run from the repository root with:
# docker compose --env-file docker/compose/.env.production -f docker/compose/traccar-project-mysql.yaml up -d

TRACCAR_IMAGE_TAG=6.15.3

TRACCAR_DB_NAME=your_traccar_database
TRACCAR_DB_USER=your_traccar_database_user
TRACCAR_DB_PASSWORD=replace_with_a_strong_database_password
TRACCAR_DB_ROOT_PASSWORD=replace_with_a_strong_root_password

TRACCAR_DATA_PATH=/absolute/path/to/traccar/data
TRACCAR_LOGS_PATH=/absolute/path/to/traccar/logs

TRACCAR_BIND_ADDRESS=0.0.0.0
TRACCAR_WEB_PORT=8082
TRACCAR_OSMAND_PORT=5055
