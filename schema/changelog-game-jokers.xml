<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

  <!-- Joker inventories, reservations and their ledger (implementation plan, stage 4). -->
  <changeSet author="traccar-tool" id="game-jokers-1">
    <!-- Per participant (real tracker) and joker type: granted quantity and uses, including uses beyond it. -->
    <createTable tableName="tc_game_jokers">
      <column name="gamesessionid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="deviceid" type="INT"><constraints nullable="false" /></column>
      <column name="type" type="VARCHAR(32)"><constraints nullable="false" /></column>
      <column name="granted" type="INT"><constraints nullable="false" /></column>
      <column name="used" type="INT"><constraints nullable="false" /></column>
      <column name="updatedat" type="TIMESTAMP(3)"><constraints nullable="false" /></column>
    </createTable>
    <addPrimaryKey tableName="tc_game_jokers" columnNames="gamesessionid,deviceid,type" constraintName="pk_game_jokers" />
    <addForeignKeyConstraint baseTableName="tc_game_jokers" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id" constraintName="fk_game_jokers_session" onDelete="CASCADE" />

    <!-- A use held by an open request (reserved) or an armed fake, until it is consumed or released. -->
    <createTable tableName="tc_game_joker_reservations">
      <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false" /></column>
      <column name="gamesessionid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="deviceid" type="INT"><constraints nullable="false" /></column>
      <column name="type" type="VARCHAR(32)"><constraints nullable="false" /></column>
      <column name="requestid" type="BIGINT" />
      <column name="status" type="VARCHAR(16)"><constraints nullable="false" /></column>
      <column name="details" type="VARCHAR(2048)"><constraints nullable="false" /></column>
      <column name="createdat" type="TIMESTAMP(3)"><constraints nullable="false" /></column>
      <column name="updatedat" type="TIMESTAMP(3)"><constraints nullable="false" /></column>
    </createTable>
    <createIndex tableName="tc_game_joker_reservations" indexName="idx_game_joker_reservations_status">
      <column name="gamesessionid" />
      <column name="status" />
    </createIndex>
    <addForeignKeyConstraint baseTableName="tc_game_joker_reservations" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id" constraintName="fk_game_joker_reservations_session" onDelete="CASCADE" />
    <addForeignKeyConstraint baseTableName="tc_game_joker_reservations" baseColumnNames="requestid"
      referencedTableName="tc_game_requests" referencedColumnNames="id" constraintName="fk_game_joker_reservations_request" onDelete="SET NULL" />

    <!-- Every grant, revoke, reservation, release and use, with who caused it. -->
    <createTable tableName="tc_game_joker_ledger">
      <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false" /></column>
      <column name="gamesessionid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="deviceid" type="INT"><constraints nullable="false" /></column>
      <column name="type" type="VARCHAR(32)"><constraints nullable="false" /></column>
      <column name="kind" type="VARCHAR(16)"><constraints nullable="false" /></column>
      <column name="quantity" type="INT"><constraints nullable="false" /></column>
      <column name="requestid" type="BIGINT" />
      <column name="reservationid" type="BIGINT" />
      <column name="actor" type="VARCHAR(128)" />
      <column name="detail" type="VARCHAR(512)" />
      <column name="occurredat" type="TIMESTAMP(3)"><constraints nullable="false" /></column>
    </createTable>
    <createIndex tableName="tc_game_joker_ledger" indexName="idx_game_joker_ledger_session">
      <column name="gamesessionid" />
      <column name="id" />
    </createIndex>
    <addForeignKeyConstraint baseTableName="tc_game_joker_ledger" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id" constraintName="fk_game_joker_ledger_session" onDelete="CASCADE" />
  </changeSet>
</databaseChangeLog>
