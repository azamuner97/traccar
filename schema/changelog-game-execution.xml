<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

  <!--
    Game execution, phase 0 (Claude outputs/game-execution-plan.md, B0, B1 and B5). It follows the rules of
    changelog-game-model-2.xml (gm prefix, UTC DATETIME(3), "at most one active" marker columns, no referential
    action between game tables).

    - tc_game_session_state: the game state of a session (running or stopped), set only with the Tool's Start and
      Stop game buttons. runningkey is 1 while running and null otherwise, so its unique constraint allows at most
      one running session per server. A session without a row is stopped.
    - The lease no longer names an executing session: tc_game_controller loses gamesessionid.
    - Requests no longer expire: tc_game_requests loses expiresat (its status 'expired' stays valid for history).
    - Execution events: tc_game_session_logs gets a nullable data column (validated JSON, at most 4 KB).
  -->
  <changeSet author="traccar-tool" id="game-execution-1-session-state">
    <createTable tableName="tc_game_session_state">
      <column name="gamesessionid" type="BIGINT">
        <constraints primaryKey="true" primaryKeyName="pk_gm_session_state" nullable="false" />
      </column>
      <column name="state" type="VARCHAR(16)"><constraints nullable="false" /></column>
      <column name="changedat" type="DATETIME(3)"><constraints nullable="false" /></column>
      <column name="changedby" type="VARCHAR(128)" />
      <column name="runningkey" type="INT" />
    </createTable>
    <addForeignKeyConstraint baseTableName="tc_game_session_state" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id" constraintName="fk_gm_session_state_session" />
    <addUniqueConstraint tableName="tc_game_session_state" columnNames="runningkey"
      constraintName="uq_gm_session_state_running" />
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-1-session-state-check">
    <sql>
      ALTER TABLE tc_game_session_state ADD CONSTRAINT ck_gm_session_state
        CHECK ((state = 'running' AND runningkey IS NOT NULL AND runningkey = 1)
          OR (state = 'stopped' AND runningkey IS NULL));
    </sql>
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-1-lease-session">
    <dropForeignKeyConstraint baseTableName="tc_game_controller" constraintName="fk_gm_controller_session" />
    <dropColumn tableName="tc_game_controller" columnName="gamesessionid" />
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-1-request-expiry">
    <dropIndex tableName="tc_game_requests" indexName="idx_gm_requests_status_expiry" />
    <dropColumn tableName="tc_game_requests" columnName="expiresat" />
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-1-log-data">
    <addColumn tableName="tc_game_session_logs">
      <column name="data" type="CLOB" />
    </addColumn>
  </changeSet>

  <!--
    Phase 1: the server-run timetable (Claude outputs/game-execution-plan.md, 1.1). The published-workbook tables
    of model 2 are dropped with their data; timetable fakes planned on them return their joker first, and their
    open requests end. The new tables:

    - tc_game_timetables: the plan revision (changed only by edits, never by execution) and the execution toggle.
    - tc_game_timetable_participants: the columns (player and supporter members) and their order. Retired members
      stay listed so their history remains visible.
    - tc_game_timetable_slots: the rows. activeat equals scheduledat unless the slot is removed, so the unique
      (gamesessionid, activeat) allows one live slot per time. Moving a slot changes only scheduledat.
    - tc_game_timetable_entries: the cells. An absent cell has no entry; blank content is a real ping. Removed
      slots and cancelled entries are kept, because tc_game_fake_ping_plans references entries.
    - tc_game_timetable_changes: recorded changesets (changeId, request hash, result), so a retried changeset
      answers its recorded result.
  -->
  <changeSet author="traccar-tool" id="game-execution-2-timetable-fakes">
    <sql>
      UPDATE tc_game_requests SET status = 'cancelled', message = 'The timetable was replaced',
          completedat = updatedat
        WHERE status IN ('pending', 'approved', 'executing') AND id IN (SELECT r.requestid
          FROM tc_game_joker_reservations r JOIN tc_game_fake_ping_plans p ON p.reservationid = r.id
          WHERE p.timetableentryid IS NOT NULL AND r.requestid IS NOT NULL);
      INSERT INTO tc_game_joker_ledger (gamesessionid, memberid, type, kind, quantity, requestid, reservationid,
          actor, detail, occurredat)
        SELECT r.gamesessionid, r.memberid, r.type, 'release', 1, r.requestid, r.id, NULL,
            'The timetable was replaced', r.updatedat
          FROM tc_game_joker_reservations r JOIN tc_game_fake_ping_plans p ON p.reservationid = r.id
          WHERE p.timetableentryid IS NOT NULL AND r.status = 'reserved';
      UPDATE tc_game_joker_reservations SET status = 'released'
        WHERE status = 'reserved' AND id IN (SELECT reservationid FROM tc_game_fake_ping_plans
          WHERE timetableentryid IS NOT NULL);
      DELETE FROM tc_game_fake_ping_plans WHERE timetableentryid IS NOT NULL;
    </sql>
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-2-drop-timetable">
    <dropForeignKeyConstraint baseTableName="tc_game_fake_ping_plans" constraintName="fk_gm_fake_plans_entry" />
    <dropTable tableName="tc_game_timetable_entries" />
    <dropTable tableName="tc_game_timetables" />
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-2-timetable">
    <createTable tableName="tc_game_timetables">
      <column name="gamesessionid" type="BIGINT">
        <constraints primaryKey="true" primaryKeyName="pk_gm_timetables" nullable="false" />
      </column>
      <column name="revision" type="BIGINT"><constraints nullable="false" /></column>
      <column name="enabled" type="BOOLEAN"><constraints nullable="false" /></column>
      <column name="enabledchangedat" type="DATETIME(3)" />
      <column name="updatedat" type="DATETIME(3)"><constraints nullable="false" /></column>
    </createTable>
    <addForeignKeyConstraint baseTableName="tc_game_timetables" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id" constraintName="fk_gm_timetables_session" />

    <createTable tableName="tc_game_timetable_participants">
      <column name="gamesessionid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="memberid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="ordinal" type="INT"><constraints nullable="false" /></column>
    </createTable>
    <addPrimaryKey tableName="tc_game_timetable_participants" columnNames="gamesessionid,memberid"
      constraintName="pk_gm_timetable_participants" />
    <addForeignKeyConstraint baseTableName="tc_game_timetable_participants" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id"
      constraintName="fk_gm_tt_participants_session" />
    <addForeignKeyConstraint baseTableName="tc_game_timetable_participants" baseColumnNames="gamesessionid,memberid"
      referencedTableName="tc_game_session_members" referencedColumnNames="gamesessionid,id"
      constraintName="fk_gm_tt_participants_member" />

    <createTable tableName="tc_game_timetable_slots">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_gm_timetable_slots" nullable="false" />
      </column>
      <column name="gamesessionid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="scheduledat" type="DATETIME(3)"><constraints nullable="false" /></column>
      <column name="state" type="VARCHAR(16)"><constraints nullable="false" /></column>
      <column name="claimedat" type="DATETIME(3)" />
      <column name="finishedat" type="DATETIME(3)" />
      <column name="activeat" type="DATETIME(3)" />
    </createTable>
    <addUniqueConstraint tableName="tc_game_timetable_slots" columnNames="gamesessionid,id"
      constraintName="uq_gm_slots_session_id" />
    <addUniqueConstraint tableName="tc_game_timetable_slots" columnNames="gamesessionid,activeat"
      constraintName="uq_gm_slots_active_time" />
    <addForeignKeyConstraint baseTableName="tc_game_timetable_slots" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id" constraintName="fk_gm_slots_session" />
    <createIndex tableName="tc_game_timetable_slots" indexName="idx_gm_slots_due">
      <column name="gamesessionid" /><column name="state" /><column name="scheduledat" />
    </createIndex>

    <createTable tableName="tc_game_timetable_entries">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_gm_timetable_entries" nullable="false" />
      </column>
      <column name="gamesessionid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="slotid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="memberid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="content" type="VARCHAR(512)"><constraints nullable="false" /></column>
      <column name="status" type="VARCHAR(16)"><constraints nullable="false" /></column>
      <column name="statusat" type="DATETIME(3)" />
      <column name="reason" type="VARCHAR(32)" />
      <column name="detail" type="VARCHAR(512)" />
    </createTable>
    <addUniqueConstraint tableName="tc_game_timetable_entries" columnNames="gamesessionid,id"
      constraintName="uq_gm_entries_session_id" />
    <addUniqueConstraint tableName="tc_game_timetable_entries" columnNames="slotid,memberid"
      constraintName="uq_gm_entries_cell" />
    <addForeignKeyConstraint baseTableName="tc_game_timetable_entries" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id" constraintName="fk_gm_entries_session" />
    <addForeignKeyConstraint baseTableName="tc_game_timetable_entries" baseColumnNames="gamesessionid,slotid"
      referencedTableName="tc_game_timetable_slots" referencedColumnNames="gamesessionid,id"
      constraintName="fk_gm_entries_slot" />
    <addForeignKeyConstraint baseTableName="tc_game_timetable_entries" baseColumnNames="gamesessionid,memberid"
      referencedTableName="tc_game_session_members" referencedColumnNames="gamesessionid,id"
      constraintName="fk_gm_entries_member" />
    <createIndex tableName="tc_game_timetable_entries" indexName="idx_gm_entries_member">
      <column name="gamesessionid" /><column name="memberid" /><column name="status" />
    </createIndex>

    <createTable tableName="tc_game_timetable_changes">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_gm_timetable_changes" nullable="false" />
      </column>
      <column name="gamesessionid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="changeid" type="VARCHAR(64)"><constraints nullable="false" /></column>
      <column name="requesthash" type="VARCHAR(64)"><constraints nullable="false" /></column>
      <column name="result" type="CLOB"><constraints nullable="false" /></column>
      <column name="createdat" type="DATETIME(3)"><constraints nullable="false" /></column>
    </createTable>
    <addUniqueConstraint tableName="tc_game_timetable_changes" columnNames="gamesessionid,changeid"
      constraintName="uq_gm_timetable_changes" />
    <addForeignKeyConstraint baseTableName="tc_game_timetable_changes" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id"
      constraintName="fk_gm_timetable_changes_session" />

    <addForeignKeyConstraint baseTableName="tc_game_fake_ping_plans" baseColumnNames="gamesessionid,timetableentryid"
      referencedTableName="tc_game_timetable_entries" referencedColumnNames="gamesessionid,id"
      constraintName="fk_gm_fake_plans_entry" />
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-2-timetable-checks">
    <sql>
      ALTER TABLE tc_game_timetable_slots ADD CONSTRAINT ck_gm_slots_state
        CHECK ((state IN ('scheduled', 'claimed', 'done') AND activeat IS NOT NULL AND activeat = scheduledat)
          OR (state = 'removed' AND activeat IS NULL));
      ALTER TABLE tc_game_timetable_entries ADD CONSTRAINT ck_gm_entries_status
        CHECK (status IN ('scheduled', 'sent', 'skipped', 'failed', 'cancelled'));
      ALTER TABLE tc_game_timetable_participants ADD CONSTRAINT ck_gm_tt_participants_ordinal
        CHECK (ordinal >= 0);
    </sql>
  </changeSet>

  <!--
    Phase 2: live uploads and relays run on the server (Claude outputs/game-execution-plan.md, phase 2). The server
    ticks every active tc_game_live_uploads row at its interval while the game runs, whatever the controller lease
    does, so the controller epoch of a row no longer matters and is dropped. The row keeps what later ticks need:

    - usejoker / overallocate: a hunter relay uses one "Get hunter positions" joker with its first tick that
      delivers (beyond the allocation only with overallocate); overallocate also lets a live speedhunt ping that
      starts a run use a pool joker beyond the allocation.
    - pingnumber / startedby: the pingDelivered fields of a live speedhunt ping's first delivered sample.
    - laststatus / lastreason / lastdelivered: the outcome of the latest tick (sent, skipped, failed, the engine's
      reason and the audiences that received it), so an execution event is written only when it changes, also
      across a restart.

    Uploads the Tool ran before are ended (endreason migrated): the server never resumes them.
  -->
  <changeSet author="traccar-tool" id="game-execution-3-live-uploads">
    <sql>
      UPDATE tc_game_live_uploads SET state = 'ended', endedat = COALESCE(lastsampleat, startedat),
          endreason = 'migrated'
        WHERE state = 'active';
    </sql>
    <dropColumn tableName="tc_game_live_uploads" columnName="controllerepoch" />
    <addColumn tableName="tc_game_live_uploads">
      <column name="usejoker" type="BOOLEAN" defaultValueBoolean="false"><constraints nullable="false" /></column>
      <column name="overallocate" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false" />
      </column>
      <column name="pingnumber" type="INT" />
      <column name="startedby" type="VARCHAR(128)" />
      <column name="laststatus" type="VARCHAR(16)" />
      <column name="lastreason" type="VARCHAR(32)" />
      <column name="lastdelivered" type="VARCHAR(40)" />
    </addColumn>
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-3-live-uploads-checks">
    <sql>
      ALTER TABLE tc_game_live_uploads ADD CONSTRAINT ck_gm_live_uploads_joker
        CHECK (usejoker = FALSE OR purpose = 'hunterRelay');
      ALTER TABLE tc_game_live_uploads ADD CONSTRAINT ck_gm_live_uploads_ping
        CHECK (pingnumber IS NULL OR (purpose = 'speedhuntPing' AND pingnumber >= 1));
      ALTER TABLE tc_game_live_uploads ADD CONSTRAINT ck_gm_live_uploads_last
        CHECK (laststatus IS NULL OR laststatus IN ('sent', 'skipped', 'failed'));
    </sql>
  </changeSet>

  <!--
    Phase 4: every ping is an intent (Claude outputs/game-execution-plan.md, phase 4). The Tool no longer sends mirror
    positions; a one-off hunter relay is a relay intent of an effects delivery, decided and written by the server.

    - tc_game_relays: one row per one-off hunter relay that delivered: who received the hunters' positions, when,
      how many hunters, and the request it fulfilled or the joker reservation it used. Live relays keep their rows in
      tc_game_live_uploads (lastsampleat); the last relay delivery of a member is the newest of both.
  -->
  <changeSet author="traccar-tool" id="game-execution-4-relays">
    <createTable tableName="tc_game_relays">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" primaryKeyName="pk_gm_relays" nullable="false" />
      </column>
      <column name="gamesessionid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="recipientmemberid" type="BIGINT"><constraints nullable="false" /></column>
      <column name="deliveredat" type="DATETIME(3)"><constraints nullable="false" /></column>
      <column name="hunters" type="INT"><constraints nullable="false" /></column>
      <column name="requestid" type="BIGINT" />
      <column name="reservationid" type="BIGINT" />
    </createTable>
    <addForeignKeyConstraint baseTableName="tc_game_relays" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id" constraintName="fk_gm_relays_session" />
    <addForeignKeyConstraint baseTableName="tc_game_relays" baseColumnNames="gamesessionid,recipientmemberid"
      referencedTableName="tc_game_session_members" referencedColumnNames="gamesessionid,id"
      constraintName="fk_gm_relays_recipient" />
    <addForeignKeyConstraint baseTableName="tc_game_relays" baseColumnNames="gamesessionid,requestid"
      referencedTableName="tc_game_requests" referencedColumnNames="gamesessionid,id"
      constraintName="fk_gm_relays_request" />
    <addForeignKeyConstraint baseTableName="tc_game_relays" baseColumnNames="gamesessionid,reservationid"
      referencedTableName="tc_game_joker_reservations" referencedColumnNames="gamesessionid,id"
      constraintName="fk_gm_relays_reservation" />
    <createIndex tableName="tc_game_relays" indexName="idx_gm_relays_recipient">
      <column name="gamesessionid" /><column name="recipientmemberid" /><column name="deliveredat" />
    </createIndex>
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-4-relays-check">
    <sql>
      ALTER TABLE tc_game_relays ADD CONSTRAINT ck_gm_relays_hunters CHECK (hunters >= 1);
    </sql>
  </changeSet>

  <!--
    Phase 5: the device list is a server document edited in the Tool's grid editor (Claude outputs/
    game-execution-plan.md, phase 5). It is the desired list (rows of name, device identifier, role and role
    number), validated on every write; device setup reads it and applies it to the members and Traccar devices.
    The session's applied roster stays in its settings and member rows.

    - tc_game_device_lists: one revisioned document per session (no row = revision 0, an empty list), like
      tc_game_geofence_plans.
  -->
  <changeSet author="traccar-tool" id="game-execution-5-device-lists">
    <createTable tableName="tc_game_device_lists">
      <column name="gamesessionid" type="BIGINT">
        <constraints primaryKey="true" primaryKeyName="pk_gm_device_lists" nullable="false" />
      </column>
      <column name="revision" type="BIGINT"><constraints nullable="false" /></column>
      <column name="data" type="CLOB"><constraints nullable="false" /></column>
      <column name="updatedat" type="DATETIME(3)"><constraints nullable="false" /></column>
    </createTable>
    <addForeignKeyConstraint baseTableName="tc_game_device_lists" baseColumnNames="gamesessionid"
      referencedTableName="tc_game_sessions" referencedColumnNames="id" constraintName="fk_gm_device_lists_session" />
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-5-device-lists-check">
    <sql>
      ALTER TABLE tc_game_device_lists ADD CONSTRAINT ck_gm_device_lists_revision CHECK (revision >= 1);
    </sql>
  </changeSet>

  <!--
    Review fixes (package E):

    - SC-9: a stopped game has no open request. Requests left open by the phase-0 migration (or written to a
      stopped session before the stop became a barrier) are ended as a stop ends them: pending and approved ones
      cancelled, executing ones failed, "The game was stopped", and their reserved jokers released with a ledger
      row. Sessions whose game runs keep theirs.
    - SC-11: controller history keeps only the events of the documented enum; model 2's executing and
      stoppedExecuting rows (from the removed setExecuting) are dropped.

    Each changeset is plain DML, so a failure rolls it back as a whole and it can run again.
  -->
  <changeSet author="traccar-tool" id="game-execution-6-stopped-requests">
    <sql>
      UPDATE tc_game_fake_ping_plans SET openentryid = NULL, unboundmemberid = NULL
        WHERE reservationid IN (SELECT r.id FROM tc_game_joker_reservations r
          JOIN tc_game_requests q ON q.gamesessionid = r.gamesessionid AND q.id = r.requestid
          WHERE r.status = 'reserved' AND q.status IN ('pending', 'approved', 'executing')
            AND NOT EXISTS (SELECT 1 FROM tc_game_session_state s
              WHERE s.gamesessionid = q.gamesessionid AND s.state = 'running'));
      INSERT INTO tc_game_joker_ledger (gamesessionid, memberid, type, kind, quantity, requestid, reservationid,
          actor, detail, occurredat)
        SELECT r.gamesessionid, r.memberid, r.type, 'release', 1, r.requestid, r.id, NULL,
            CASE WHEN q.status = 'executing' THEN 'Request failed' ELSE 'Request cancelled' END, q.updatedat
          FROM tc_game_joker_reservations r
          JOIN tc_game_requests q ON q.gamesessionid = r.gamesessionid AND q.id = r.requestid
          WHERE r.status = 'reserved' AND q.status IN ('pending', 'approved', 'executing')
            AND NOT EXISTS (SELECT 1 FROM tc_game_session_state s
              WHERE s.gamesessionid = q.gamesessionid AND s.state = 'running');
      UPDATE tc_game_joker_reservations SET status = 'released'
        WHERE status = 'reserved' AND requestid IN (SELECT q.id FROM tc_game_requests q
          WHERE q.status IN ('pending', 'approved', 'executing')
            AND NOT EXISTS (SELECT 1 FROM tc_game_session_state s
              WHERE s.gamesessionid = q.gamesessionid AND s.state = 'running'));
      UPDATE tc_game_requests SET
          status = CASE WHEN status = 'executing' THEN 'failed' ELSE 'cancelled' END,
          message = 'The game was stopped', completedat = updatedat
        WHERE status IN ('pending', 'approved', 'executing')
          AND gamesessionid NOT IN (SELECT gamesessionid FROM tc_game_session_state WHERE state = 'running');
    </sql>
  </changeSet>

  <changeSet author="traccar-tool" id="game-execution-6-controller-history">
    <sql>
      DELETE FROM tc_game_controller_history WHERE event IN ('executing', 'stoppedExecuting');
    </sql>
  </changeSet>

</databaseChangeLog>
