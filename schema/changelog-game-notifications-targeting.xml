<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">
  <changeSet author="traccar-tool" id="game-notifications-targeting-1">
    <addColumn tableName="tc_game_notifications">
      <column name="recipientuserid" type="INT" />
      <column name="sourcedeviceid" type="INT" />
    </addColumn>
    <addForeignKeyConstraint baseTableName="tc_game_notifications" baseColumnNames="recipientuserid"
      referencedTableName="tc_users" referencedColumnNames="id"
      constraintName="fk_game_notifications_recipient" onDelete="CASCADE" />
    <createIndex tableName="tc_game_notifications" indexName="idx_game_notifications_recipient">
      <column name="sessiondeviceid" /><column name="generation" />
      <column name="recipientuserid" /><column name="id" />
    </createIndex>
  </changeSet>
</databaseChangeLog>
